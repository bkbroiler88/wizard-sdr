# Signalhound IDF project defaults

# No arduino loop task; app_main owns things.
CONFIG_AUTOSTART_ARDUINO=n

# Real CW tone support (what the whole migration was for).
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y

# 1 kHz tick keeps vTaskDelay(1) math predictable (same as Arduino default).
CONFIG_FREERTOS_HZ=1000

# UART logging at 115200 (Signalhound's serial speed).
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Give app plenty of flash with the project's existing huge_app layout.
# (partitions.csv at project root is used.)
